ARG PG_VERSION=18

# Builder: pgaudit from source when no binary package exists (PG 17)
FROM ghcr.io/daemonless/postgres:${PG_VERSION} AS builder-pgaudit
ARG PG_VERSION
ARG PGAUDIT_VERSION

RUN pkg update && \
    mkdir -p /out/lib /out/ext && \
    if ! pkg rquery '%v' "postgresql${PG_VERSION}-pgaudit" >/dev/null 2>&1; then \
        pkg install -y \
            FreeBSD-bmake FreeBSD-clibs-dev FreeBSD-clang FreeBSD-clang-dev FreeBSD-toolchain \
            gmake pkgconf openssl && \
        fetch -qo /tmp/pgaudit.tar.gz \
            "https://github.com/pgaudit/pgaudit/archive/refs/tags/${PGAUDIT_VERSION}.tar.gz" && \
        tar -xzf /tmp/pgaudit.tar.gz -C /tmp && \
        cd /tmp/pgaudit-${PGAUDIT_VERSION} && \
        gmake USE_PGXS=1 install && \
        cp /usr/local/lib/postgresql/pgaudit.so /out/lib/ && \
        cp /usr/local/share/postgresql/extension/pgaudit* /out/ext/ && \
        rm -rf /tmp/pgaudit*; \
    fi && \
    pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Builder: pg_failover_slots from source when no binary package exists (PG 17)
FROM ghcr.io/daemonless/postgres:${PG_VERSION} AS builder-failover-slots
ARG PG_VERSION
ARG PG_FAILOVER_SLOTS_VERSION

RUN pkg update && \
    mkdir -p /out/lib && \
    if ! pkg rquery '%v' "postgresql${PG_VERSION}-pg_failover_slots" >/dev/null 2>&1; then \
        pkg install -y \
            FreeBSD-bmake FreeBSD-clibs-dev FreeBSD-clang FreeBSD-clang-dev FreeBSD-toolchain \
            gmake pkgconf openssl && \
        fetch -qo /tmp/pg_failover_slots.tar.gz \
            "https://github.com/EnterpriseDB/pg_failover_slots/archive/refs/tags/v${PG_FAILOVER_SLOTS_VERSION}.tar.gz" && \
        tar -xzf /tmp/pg_failover_slots.tar.gz -C /tmp && \
        cd /tmp/pg_failover_slots-${PG_FAILOVER_SLOTS_VERSION} && \
        gmake USE_PGXS=1 install && \
        cp /usr/local/lib/postgresql/pg_failover_slots.so /out/lib/ && \
        rm -rf /tmp/pg_failover_slots*; \
    fi && \
    pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Production image
FROM ghcr.io/daemonless/postgres:${PG_VERSION}

ARG PG_VERSION
ARG FREEBSD_ARCH=amd64

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="{{ title }} ${PG_VERSION}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="{{ repo_url }}" \
      org.opencontainers.image.url="{{ web_url }}" \
      org.opencontainers.image.documentation="https://www.postgresql.org/docs/${PG_VERSION}/" \
      org.opencontainers.image.licenses="PostgreSQL" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="{{ category }}" \
{%- if volumes %}
      io.daemonless.volumes="{{ volumes | map(attribute='path') | join(',') }}" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}"

COPY --from=builder-pgaudit /out /tmp/pgaudit-out
COPY --from=builder-failover-slots /out /tmp/failover-out
RUN pkg update && \
    if [ -f /tmp/pgaudit-out/lib/pgaudit.so ]; then \
        cp /tmp/pgaudit-out/lib/pgaudit.so /usr/local/lib/postgresql/ && \
        cp /tmp/pgaudit-out/ext/pgaudit* /usr/local/share/postgresql/extension/; \
    else \
        pkg install -y "postgresql${PG_VERSION}-pgaudit"; \
    fi && \
    if [ -f /tmp/failover-out/lib/pg_failover_slots.so ]; then \
        cp /tmp/failover-out/lib/pg_failover_slots.so /usr/local/lib/postgresql/; \
    else \
        pkg install -y "postgresql${PG_VERSION}-pg_failover_slots"; \
    fi && \
    rm -rf /tmp/pgaudit-out /tmp/failover-out && \
    pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# No ENTRYPOINT or CMD — CloudNativePG overrides with its instance manager
